# Database
DATABASE_URL=sqlite:///./app.db

# Frontend URL (don't change this for local development)
FRONTEND_ORIGIN=http://localhost:5173

# Google Cloud - Vertex AI
# 1. Get the service-account.json file from the team privately (do NOT push it to GitHub)
# 2. Place it in the backend/ folder
# 3. Set GOOGLE_CLOUD_PROJECT to the shared project name below
GOOGLE_CLOUD_PROJECT=job-tracker-gcp
GOOGLE_APPLICATION_CREDENTIALS=service-account.json
SECRET_KEY=CSCI-6221-Job-Tracker
# Get a free Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here
# Get a free Groq API key from https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here